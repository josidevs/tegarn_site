# Force HTTPS and the bare domain (but leave AutoSSL validation alone)
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tegarnbygg.se%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
Options -Indexes
